# Telegram Voice Transcription Bot

# Application Bot Token (from @BotFather)
PUBLIC_BOT_TOKEN=your-public-bot-token-here

# Groq API Key
GROQ_API_KEY=your-groq-api-key-here

# Access control: comma-separated @usernames and/or numeric Telegram user IDs.
# Usernames are case-insensitive (@ optional); numeric IDs are the stronger
# check - include your own ID too if you know it.
# MISSING/EMPTY = the bot refuses everyone (fail-closed).
ALLOWED_USERS=@your_username,123456789
